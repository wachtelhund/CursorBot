{
  "name": "cursor-bots",
  "version": "0.1.1",
  "private": true,
  "description": "Desktop teammates that run as Cursor Cloud Agents",
  "author": "Hampus Nilsson",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dist": "electron-vite build && env -u ELECTRON_RUN_AS_NODE electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --test src/shared/*.test.ts src/mcp/*.test.ts",
    "mcp": "node --experimental-strip-types src/mcp/server.ts",
    "dev:debug": "env -u ELECTRON_RUN_AS_NODE electron-vite dev -- --remote-debugging-port=9223"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.28"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "dev.cursorbots.app",
    "productName": "Cursor Bots",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@cursor/**"
    ],
    "artifactName": "Cursor-Bots-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleName": "Cursor Bots",
        "CFBundleDisplayName": "Cursor Bots",
        "NSLocalNetworkUsageDescription": "Cursor Bots shares the chat UI with your phone on the local network."
      },
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
